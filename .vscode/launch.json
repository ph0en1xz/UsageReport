{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UsageReport.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/UsageReport.Api/bin/Debug/net8.0/UsageReport.Api.dll",
      "cwd": "${workspaceFolder}/src/UsageReport.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5018"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
